PORT=3000
NODE_ENV=development

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vyas
# Max Postgres pool connections (default 20 if unset)
DB_POOL_MAX=20

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_at_least_32_random_chars
# Session idle window in hours (default 8). The cookie slides: protect re-issues
# it on activity past the halfway mark, so active users are never logged out.
JWT_EXPIRY_HOURS=8

# Redis — use redis:// scheme (NOT http://)
REDIS_URL=redis://localhost:6379

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Google OAuth — create credentials at https://console.cloud.google.com
# (OAuth consent screen + OAuth 2.0 Web application client), and register
# both the local and production callback URLs as Authorized redirect URIs.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# SMTP — for password reset emails
# Use Mailtrap (https://mailtrap.io) for local dev, or MIT WPU SMTP in production
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Vyas Room Booking" <noreply@mitwpu.edu.in>

# Timetable Import System
GEMINI_API_KEY=your_gemini_api_key_here
AWS_REGION=us-east-1
S3_BUCKET=your_s3_bucket_name
LLM_PROVIDER=gemini
OCR_TEXT_THRESHOLD=100
LLM_RETRY_COUNT=3

# Background workers. Default (unset/true) runs the email + import workers inside
# the API process — fine for `npm run dev`. In production set RUN_WORKERS=false on
# the app and run `node worker.js` as its own service (see docker-compose.yml).
RUN_WORKERS=true

# Import-pipeline safety caps (defaults shown; only set to override)
# IMPORT_PDF_MAX_PAGES=50            # PDFs over this are rejected (not OCR'd)
# IMPORT_MAX_EXTRACTED_CHARS=1000000 # max text extracted from one file
# IMPORT_EXTRACT_TIMEOUT_MS=60000    # wall-clock cap for one file's extraction
# IMPORT_EXTRACT_HEAP_MB=512         # extraction thread JS-heap cap
# IMPORT_EXTRACT_MEM_MB=768          # extraction thread heap+typed-array cap (PDF flate bombs);
#                                    # keep well under the worker container's mem_limit

# Docker note: `docker compose` env files do NOT parse the SMTP_FROM line above the way
# dotenv does. In /opt/vyas/app.env quote it as:  SMTP_FROM='"Vyas Room Booking" <noreply@mitwpu.edu.in>'
# Production: FRONTEND_ORIGIN must be the real frontend origin (e.g. https://vyas.iris-club.in);
# the localhost dev origins are only allowed when NODE_ENV != production.

# RDS TLS (production). RDS Postgres 15+ enforces SSL. DB_SSL=true verifies the server against a CA
# bundle: certs/rds-global-bundle.pem (the AWS RDS global bundle) unless DB_SSL_CA points elsewhere.
# It never falls back to an unverified connection. Leave unset for local Postgres.
# DB_SSL=true
# DB_SSL_CA=/app/certs/rds-global-bundle.pem

# First admin (production has no seed). Pass these on the command line, not in app.env:
#   docker compose run --rm -e ADMIN_EMAIL=... -e ADMIN_PASSWORD=... app node scripts/create-admin.mjs
#   (ADMIN_NAME optional; ADMIN_RESET_PASSWORD=1 to change an existing user's password)
