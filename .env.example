PORT=3000
NODE_ENV=development

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vyas

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_at_least_32_random_chars

# Redis — use redis:// scheme (NOT http://)
REDIS_URL=redis://localhost:6379

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Google OAuth — create credentials at https://console.cloud.google.com
# (OAuth consent screen + OAuth 2.0 Web application client), and register
# both the local and production callback URLs as Authorized redirect URIs.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# SMTP — for password reset emails
# Use Mailtrap (https://mailtrap.io) for local dev, or MIT WPU SMTP in production
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Vyas Room Booking" <noreply@mitwpu.edu.in>

# Timetable Import System
GEMINI_API_KEY=your_gemini_api_key_here
AWS_REGION=us-east-1
S3_BUCKET=your_s3_bucket_name
LLM_PROVIDER=gemini
OCR_TEXT_THRESHOLD=100
LLM_RETRY_COUNT=3
